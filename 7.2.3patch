--- a/beartype/beartype_test/math_ops.py
+++ b/beartype/beartype_test/math_ops.py
@@ -1,5 +1,30 @@
+import inspect
+from functools import wraps
 from beartype import beartype
 
+def coerce_int_args(func):
+    """
+    自动尝试将标注为 int 的参数转换为整数。
+    转换失败时保留原值，交由底层的 @beartype 触发严格的类型异常。
+    """
+    sig = inspect.signature(func)
+    
+    @wraps(func)
+    def wrapper(*args, **kwargs):
+        bound = sig.bind(*args, **kwargs)
+        bound.apply_defaults()
+        
+        for name, value in bound.arguments.items():
+            param = sig.parameters[name]
+            if param.annotation is int and not isinstance(value, int):
+                try:
+                    bound.arguments[name] = int(value)
+                except (ValueError, TypeError):
+                    pass
+                    
+        return func(*bound.args, **bound.kwargs)
+    return wrapper
+
+@coerce_int_args
 @beartype
 def divide(a: int, b: int) -> float:
     return a / b
