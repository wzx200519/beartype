+  # ...................{ TESTS ~ DOOR                       }...................
+  # Job independently validating the "beartype.door" submodule and collecting
+  # a dedicated coverage report for Codecov.
+  test_door:
+    name: '[ubuntu-latest] Python 3.13 DOOR CI'
+    runs-on: 'ubuntu-latest'
+    timeout-minutes: 20
+
+    env:
+      PIP_NO_PIP_VERSION_CHECK: 1
+      PIP_PREFER_BINARY: 1
+      PYTHONFAULTHANDLER: 1
+      PYTHONUNBUFFERED: 1
+
+    steps:
+      - name: 'Checking out repository...'
+        uses: 'actions/checkout@v6'
+      - name: 'Installing Python 3.13...'
+        uses: 'actions/setup-python@v6'
+        with:
+          python-version: '3.13'
+      - name: 'Installing uv...'
+        uses: 'astral-sh/setup-uv@v7'
+        with:
+          enable-cache: true
+          cache-dependency-glob: 'pyproject.toml'
+      - name: 'Upgrading packager dependencies...'
+        run: |
+          uv pip install --quiet --system --upgrade pip hatch wheel
+      - name: 'Installing package dependencies...'
+        run: |
+          uv pip install --quiet --system --upgrade '.[test]' pytest-cov
+      - name: 'Testing DOOR package with "pytest"...'
+        run: |
+          python3 -m pytest beartype/door/ -v --cov=beartype.door --cov-append
+          python3 -m coverage xml -o coverage.xml
+      - name: 'Uploading DOOR coverage artifact...'
+        uses: 'actions/upload-artifact@v4'
+        with:
+          name: 'coverage-door-py313'
+          path: 'coverage.xml'
+          if-no-files-found: error
+
+  # ...................{ COVERAGE                           }...................
+  # Job uploading all previously generated coverage reports in one Codecov step,
+  # allowing Codecov to merge the reports for this workflow run.
+  coverage:
+    name: 'Publish test coverage to Codecov'
+    runs-on: 'ubuntu-latest'
+    needs:
+      - tests
+      - test_door
+
+    steps:
+      - name: 'Checking out repository...'
+        uses: 'actions/checkout@v6'
+      - name: 'Downloading coverage artifacts...'
+        uses: 'actions/download-artifact@v4'
+        with:
+          pattern: 'coverage-*'
+          path: 'coverage-reports'
